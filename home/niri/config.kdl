// Minimal Niri config. Hand-editable: home-manager symlinks this file to
// ~/.config/niri/config.kdl, so edit here and re-login (check with `niri validate`).
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

input {
    keyboard {
        xkb {
            layout "fr"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        width 3
        active-color "#cba6f7"
        inactive-color "#45475a"
    }
}

prefer-no-csd

// X11 apps (Electron, AppImages like OpenChamber) need this bridge.
spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "mako"
// Tray applets: click for Wi-Fi networks / Bluetooth devices.
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"

binds {
    Mod+Return { spawn "ghostty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Tab { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    // J/K walk down/up: stacked windows first, then the workspace below/above.
    // With one window per column they simply switch workspaces, so they always act.
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Workspaces are the vertical axis.
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }

    // AZERTY: digits are shifted, so Super+Shift+1..5 selects workspace 1..5.
    Mod+Shift+1 { focus-workspace 1; }
    Mod+Shift+2 { focus-workspace 2; }
    Mod+Shift+3 { focus-workspace 3; }
    Mod+Shift+4 { focus-workspace 4; }
    Mod+Shift+5 { focus-workspace 5; }

    Print { screenshot; }

    // Laptop media keys. wpctl talks to PipeWire; brightnessctl to the backlight.
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
}
