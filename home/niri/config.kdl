// Minimal Niri config. Hand-editable: home-manager symlinks this file to
// ~/.config/niri/config.kdl, so edit here and re-login (check with `niri validate`).
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

input {
    keyboard {
        xkb {
            layout "fr"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        width 3
        active-color "#cba6f7"
        inactive-color "#45475a"
    }
}

prefer-no-csd

// X11 apps (Electron, AppImages like OpenChamber) need this bridge.
spawn-at-startup "xwayland-satellite"

binds {
    Mod+Return { spawn "ghostty"; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+E { quit; }
    // Hotkey overlay: default binding is Mod+Shift+/; on AZERTY "/" is
    // Shift+":" (the unshifted key is colon), so both spellings are bound.
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+colon { show-hotkey-overlay; }
    // Overview: default is Mod+O; Mod+Tab kept as alias.
    Mod+O repeat=false { toggle-overview; }
    Mod+Tab { toggle-overview; }

    // Navigation follows niri's defaults: arrows and hjkl are aliases of the
    // same actions; J/K and the vertical arrows walk windows inside a column
    // (stack them first — see the stacking binds below). Ctrl moves, Shift
    // targets monitors (no-ops on the laptop screen, useful with an external
    // display).
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Stacking (niri defaults, adapted to AZERTY): the QWERTY "." key prints
    // ";" unshifted on AZERTY, and the QWERTY "[" spot is a dead key (^), so
    // the right-side consume/expel lives on the neighboring $ key.
    Mod+dollar { consume-or-expel-window-right; }
    Mod+comma { consume-window-into-column; }
    Mod+semicolon { expel-window-from-column; }
    // Render a stacked column as vertical tabs instead of a vertical pile.
    Mod+W { toggle-column-tabbed-display; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces are the vertical axis (defaults: U/I and PageUp/Down).
    // With default J/K only walking windows inside a column, these are the
    // way to hop between workspaces.
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    // Super + wheel jumps workspaces (defaults).
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    // AZERTY: the digit row types & é " ' ( è _ ç à ( with Super alone,
    // since digits need Shift there — and niri matches binds against the
    // UNSHIFTED keysym of the key per its XKB layout (niri#2982), so both
    // Mod+Shift+1 and digit keysyms (Mod+2) never match; bind the symbols
    // printed on the keys.
    Mod+ampersand { focus-workspace 1; }
    Mod+eacute { focus-workspace 2; }
    Mod+quotedbl { focus-workspace 3; }
    Mod+apostrophe { focus-workspace 4; }
    Mod+parenleft { focus-workspace 5; }
    Mod+minus { focus-workspace 6; }
    Mod+egrave { focus-workspace 7; }
    Mod+underscore { focus-workspace 8; }
    Mod+ccedilla { focus-workspace 9; }
    Mod+Ctrl+ampersand { move-column-to-workspace 1; }
    Mod+Ctrl+eacute { move-column-to-workspace 2; }
    Mod+Ctrl+quotedbl { move-column-to-workspace 3; }
    Mod+Ctrl+apostrophe { move-column-to-workspace 4; }
    Mod+Ctrl+parenleft { move-column-to-workspace 5; }
    Mod+Ctrl+minus { move-column-to-workspace 6; }
    Mod+Ctrl+egrave { move-column-to-workspace 7; }
    Mod+Ctrl+underscore { move-column-to-workspace 8; }
    Mod+Ctrl+ccedilla { move-column-to-workspace 9; }

    Print { screenshot; }

    // Vicinae launcher (systemd service started with niri).
    Mod+Space { spawn "vicinae" "toggle"; }

    // Noctalia panels (service started by systemd with niri).
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    // Mod+M: Noctalia has no dedicated process-list panel (yet) - its sysmon
    // lives in the bar/control center, so fall back to btop.
    Mod+M { spawn "btop"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+P { spawn "noctalia" "msg" "panel-toggle" "noctalia/notes:panel"; }
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "session"; }
    // Noctalia settings moved here: Mod+Comma belongs to niri's consume bind.
    Mod+S { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Alt+N allow-when-locked=true { spawn "noctalia" "msg" "nightlight-toggle"; }
    Mod+Alt+L allow-when-locked=true { spawn "noctalia" "msg" "session" "lock"; }

    // Media keys go through Noctalia so it shows its on-screen display.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down" "5"; }
}
