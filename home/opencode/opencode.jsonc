{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/repos/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.local/share/opencode/repos/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.local/share/opencode/repos/*",
      "effect": "deny"
    }
  ],
  "websearch": {
    "provider": "exa"
  },
  "mcp": {
    "servers": {
      "keenable": {
        "type": "remote",
        "url": "https://api.keenable.ai/mcp",
        "disabled": false,
        "protocol": "auto"
      }
    }
  }
}