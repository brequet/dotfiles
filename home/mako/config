# Mako notifications — hand-editable, symlinked to ~/.config/mako/config.
# Catppuccin Mocha. Started by niri (spawn-at-startup), not a systemd service,
# so it doesn't fight GNOME's notification daemon when you log into GNOME.

font=JetBrainsMono Nerd Font 11
background-color=#1e1e2ef2
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
max-visible=3
anchor=top-right
